# TIME LAB · настройки окружения (скопируй в .env и заполни; .env в git не попадает)
# Без SUPABASE_URL и SUPABASE_ANON_KEY игра работает в гостевом режиме (прогресс только в браузере).

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API → публичный ключ anon (или publishable sb_publishable_...).
# НЕ вставляй сюда service_role / sb_secret_ — сборка такой ключ откажется публиковать.
SUPABASE_ANON_KEY=your-public-anon-key
# true — показывать кнопку «Продолжить с Google» (провайдер нужно включить в Supabase)
GOOGLE_AUTH=false
# Необязательно: адрес сайта для писем (подтверждение, сброс пароля). По умолчанию — текущий адрес страницы.
SITE_URL=
# Base path сайта. Для GitHub Pages проекта: /имя-репозитория/ ; для домена или user.github.io: /
BASE_PATH=/
